{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "게임 사이트에서 '게임 종료'(창 닫기)와 F11(전체 화면 전환)을 쓸 수 있게 허용",
  "windows": ["main"],
  "remote": { "urls": ["https://nee.n-e.kr/*"] },
  "permissions": ["core:default", "core:window:allow-close", "core:window:allow-set-fullscreen", "core:window:allow-is-fullscreen"]
}
