{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "울주AI점프",
  "version": "1.0.1",
  "identifier": "kr.nee.ujump",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "울주AI점프",
        "url": "https://nee.n-e.kr/ujump/",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 450,
        "center": true,
        "resizable": true,
        "fullscreen": true,
        "backgroundColor": "#0a2a6b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "mainBinaryName": "ujump"
}